# ============================================================
# FreshMarket - Environment Variables
# ============================================================
# Copy file ini menjadi .env dan isi nilai yang sesuai.
# JANGAN commit .env asli ke git!

# --- Database (WAJIB) ---
# Format PostgreSQL: postgres://user:password@host:port/database
# Di Zeabur, ini otomatis disediakan saat menambahkan PostgreSQL service.
DATABASE_URL=postgres://user:password@localhost:5432/freshmarket

# Set true kalau koneksi butuh SSL (misal ke DB eksternal Neon/Supabase/dll)
# Untuk PostgreSQL internal Zeabur biasanya tidak perlu.
PGSSL=false

# --- Server ---
# Zeabur akan set PORT otomatis - biarkan atau ubah untuk dev lokal.
PORT=5000
NODE_ENV=production

# --- Authentication (WAJIB GANTI di production!) ---
# Generate string acak minimal 32 karakter:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-panjang-yang-random
JWT_EXPIRES_IN=7d

# --- Default Admin Seed (hanya dipakai saat DB kosong) ---
DEFAULT_ADMIN_EMAIL=admin@freshmarket.com
DEFAULT_ADMIN_PASSWORD=admin123

# --- CORS ---
# Kosongkan untuk allow semua origin.
# Untuk production isi domain publik Anda, comma-separated.
# Contoh: https://freshmarket.zeabur.app,https://freshmarket.com
CORS_ORIGIN=

# --- Debug (opsional) ---
DB_LOG=false
